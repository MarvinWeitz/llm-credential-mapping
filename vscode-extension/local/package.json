{
  "name": "vkm-local",
  "displayName": "Virtual Key Mapper: local sign-in",
  "description": "Relays your local vkm sign-in into dev containers and other remote windows; nothing is stored there.",
  "version": "0.1.0",
  "publisher": "cbs-consulting",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbs-consulting/virtual-key-mapper"
  },
  "homepage": "https://github.com/cbs-consulting/virtual-key-mapper#readme",
  "bugs": "https://github.com/cbs-consulting/virtual-key-mapper/issues",
  "engines": {
    "vscode": "^1.104.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onCommand:vkm.local.request",
    "onCommand:vkm.local.signIn"
  ],
  "contributes": {
    "configuration": {
      "title": "Virtual Key Mapper: local sign-in",
      "properties": {
        "vkm.localCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "How to run the `vkm` CLI on this computer, also for dev container and SSH windows, e.g. `[\"C:\\\\path\\\\to\\\\venv\\\\Scripts\\\\python.exe\", \"-m\", \"virtual_key_mapper\"]`. Empty: `vkm.command`, else `vkm` from PATH."
        },
        "vkm.localProfiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "Local profiles that dev container and SSH windows may get tokens for; the first one is used when a window names none. Empty: only this computer's default profile."
        }
      }
    },
    "commands": [
      {
        "command": "vkm.local.signIn",
        "title": "Sign in on this computer",
        "category": "Virtual Key Mapper"
      }
    ]
  },
  "scripts": {
    "compile": "node ../node_modules/typescript/bin/tsc -p .",
    "test": "node ../node_modules/typescript/bin/tsc -p . && node --test \"out/test/*.test.js\"",
    "package": "node ../node_modules/typescript/bin/tsc -p . && node ../node_modules/@vscode/vsce/vsce package --no-dependencies --out vkm-local.vsix"
  }
}
